<% content_for :title, "#{@student.display_name} academic profile · LearningSignal" %>

<div class="mx-auto max-w-7xl px-5 py-8 lg:px-8 lg:py-10">
  <%= link_to "← Back to dashboard", root_path, class: "text-sm font-bold text-[#32766b] hover:text-[#173f3a]" %>

  <div class="mt-6 flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
    <div class="flex items-center gap-4">
      <span class="grid size-16 place-items-center rounded-2xl bg-[#dceae6] text-xl font-bold text-[#173f3a]"><%= initials(@student.display_name) %></span>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#df6b57]">Academic profile</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight"><%= @student.display_name %></h1>
        <p class="mt-1 text-sm text-slate-500"><%= @student.external_ref %> · <%= @student.synthetic? ? "Synthetic local record" : "Student record" %></p>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <% @sections.each do |section| %>
        <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600"><%= section.course.name %> · <%= section.name %></span>
      <% end %>
    </div>
  </div>

  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Current mastery</p>
      <p class="mt-3 text-3xl font-semibold"><%= @average_mastery %>%</p>
      <p class="mt-1 text-sm text-slate-500">Average across <%= pluralize(@latest_mastery.length, "objective") %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Assessment attempts</p>
      <p class="mt-3 text-3xl font-semibold"><%= @assessment_attempts.length %></p>
      <p class="mt-1 text-sm text-slate-500"><%= pluralize(@assessment_attempts.sum { |attempt| attempt.question_responses.length }, "recorded response") %></p>
    </div>
    <div class="rounded-2xl border border-rose-100 bg-[#fffaf8] p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-rose-400">Open signals</p>
      <p class="mt-3 text-3xl font-semibold text-rose-700"><%= @signals.count { |signal| signal.status.in?(%w[open investigating]) } %></p>
      <p class="mt-1 text-sm text-slate-500"><%= pluralize(@signals.length, "signal") %> in profile history</p>
    </div>
    <div class="rounded-2xl border border-emerald-100 bg-[#f8fcfa] p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-500">Completed outcomes</p>
      <p class="mt-3 text-3xl font-semibold text-emerald-800"><%= @intervention_outcomes.count(&:completed?) %></p>
      <p class="mt-1 text-sm text-slate-500"><%= @intervention_outcomes.count { |outcome| outcome.completed? && outcome.effectiveness == 'effective' } %> marked effective</p>
    </div>
  </section>

  <div class="mt-8 grid gap-8 xl:grid-cols-[1.3fr_0.7fr]">
    <div class="space-y-8">
      <section>
        <div class="mb-4">
          <h2 class="text-lg font-bold">Learning-objective mastery</h2>
          <p class="mt-1 text-sm text-slate-500">Latest deterministic score for each objective.</p>
        </div>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <% if @latest_mastery.any? %>
            <% @latest_mastery.each_with_index do |snapshot, index| %>
              <div class="grid gap-3 px-5 py-4 sm:grid-cols-[1fr_11rem] sm:items-center <%= 'border-t border-slate-100' unless index.zero? %>">
                <div>
                  <p class="font-bold text-slate-900"><%= snapshot.learning_objective.title %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= snapshot.learning_objective.code %> · <%= snapshot.source %> · <%= snapshot.observed_on.to_fs(:long) %></p>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-[#32766b]" style="width: <%= snapshot.score %>%"></div></div>
                  <span class="w-11 text-right text-sm font-bold"><%= snapshot.score.to_i %>%</span>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="px-5 py-10 text-center text-sm text-slate-500">No mastery evidence has been recorded.</p>
          <% end %>
        </div>
      </section>

      <section>
        <div class="mb-4">
          <h2 class="text-lg font-bold">Assessment attempts and responses</h2>
          <p class="mt-1 text-sm text-slate-500">Scores are calculated from answer keys; imported files cannot supply totals.</p>
        </div>
        <div class="space-y-4">
          <% if @assessment_attempts.any? %>
            <% @assessment_attempts.each do |attempt| %>
              <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="flex flex-col justify-between gap-3 bg-slate-50 px-5 py-4 sm:flex-row sm:items-center">
                  <div>
                    <p class="font-bold text-slate-900"><%= attempt.assessment.title %></p>
                    <p class="mt-1 text-xs text-slate-500">Attempt <%= attempt.attempt_number %> · <%= attempt.submitted_at&.to_fs(:long) || "In progress" %> · <%= attempt.status.humanize %></p>
                  </div>
                  <span class="text-xl font-semibold text-[#173f3a]"><%= attempt.score.to_i %>/<%= attempt.maximum_score.to_i %> <span class="text-sm text-slate-500">(<%= attempt.percentage.to_i %>%)</span></span>
                </div>
                <div class="divide-y divide-slate-100">
                  <% attempt.question_responses.sort_by { |response| response.assessment_question.external_ref }.each do |response| %>
                    <div class="grid gap-3 px-5 py-4 sm:grid-cols-[1fr_auto] sm:items-start">
                      <div>
                        <p class="text-sm font-bold text-slate-800"><%= response.assessment_question.external_ref %> · <%= response.assessment_question.prompt_reference %></p>
                        <p class="mt-1 text-sm text-slate-600">Response: <%= response.answer %></p>
                        <p class="mt-1 text-xs text-slate-500"><%= response.assessment_question.learning_objective.code %></p>
                      </div>
                      <span class="rounded-full px-3 py-1 text-xs font-bold <%= response.correct? ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>"><%= response.correct? ? "Correct" : "Incorrect" %> · <%= response.points_earned.to_i %>/<%= response.assessment_question.maximum_points.to_i %></span>
                    </div>
                  <% end %>
                </div>
              </article>
            <% end %>
          <% else %>
            <div class="rounded-2xl border border-slate-200 bg-white px-5 py-10 text-center text-sm text-slate-500 shadow-sm">No assessment attempts have been imported.</div>
          <% end %>
        </div>
      </section>

      <section>
        <div class="mb-4"><h2 class="text-lg font-bold">Signals and interventions</h2><p class="mt-1 text-sm text-slate-500">Previous educator attention and human-reviewed plans.</p></div>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <% if @signals.any? %>
            <% @signals.each_with_index do |signal, index| %>
              <%= link_to student_signal_path(signal), class: "grid gap-3 px-5 py-4 hover:bg-slate-50 sm:grid-cols-[1fr_auto] sm:items-center #{'border-t border-slate-100' unless index.zero?}" do %>
                <span>
                  <span class="flex flex-wrap items-center gap-2"><%= priority_badge(signal.priority) %><span class="font-bold text-slate-900"><%= signal.title %></span></span>
                  <span class="mt-2 block text-sm text-slate-500"><%= signal.learning_objective.code %> · <%= signal.detected_at.to_fs(:long) %></span>
                </span>
                <% latest_plan = signal.investigations.max_by(&:created_at)&.intervention_plan %>
                <span class="text-xs font-bold text-[#32766b]"><%= latest_plan ? "Plan #{latest_plan.status.humanize}" : signal.status.humanize %> →</span>
              <% end %>
            <% end %>
          <% else %>
            <p class="px-5 py-10 text-center text-sm text-slate-500">No signals have been detected.</p>
          <% end %>
        </div>
      </section>

      <section>
        <div class="mb-4"><h2 class="text-lg font-bold">Intervention outcomes</h2><p class="mt-1 text-sm text-slate-500">Follow-up evidence and teacher assessment for approved plans.</p></div>
        <div class="space-y-4">
          <% if @intervention_outcomes.any? %>
            <% @intervention_outcomes.each do |outcome| %>
              <% plan = outcome.intervention_plan %>
              <% baseline = plan.baseline_mastery_snapshot %>
              <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
                  <div><p class="font-bold text-slate-900"><%= plan.investigation.learning_objective.title %></p><p class="mt-1 text-xs text-slate-500">Recorded by <%= outcome.recorded_by.name %> · <%= outcome.recorded_at.to_fs(:long) %></p></div>
                  <div class="flex items-center gap-2"><%= outcome_status_badge(outcome.status) %><%= effectiveness_badge(outcome.effectiveness) %></div>
                </div>
                <div class="mt-4 flex flex-wrap items-center gap-3 text-sm"><span class="rounded-lg bg-slate-50 px-3 py-2"><strong><%= baseline&.score&.to_i || "—" %>%</strong> before</span><span class="text-slate-300">→</span><span class="rounded-lg bg-emerald-50 px-3 py-2 text-emerald-800"><strong><%= outcome.follow_up_mastery_score&.to_i || "—" %>%</strong> after</span><span class="font-bold text-[#32766b]"><%= mastery_change_label(baseline&.score, outcome.follow_up_mastery_score) %></span></div>
                <p class="mt-4 text-sm leading-6 text-slate-600"><%= outcome.teacher_assessment.presence || "Teacher assessment pending." %></p>
                <%= link_to "View comparison →", investigation_path(plan.investigation, anchor: "intervention-outcome"), class: "mt-4 inline-block text-sm font-bold text-[#32766b]" %>
              </article>
            <% end %>
          <% else %>
            <div class="rounded-2xl border border-slate-200 bg-white px-5 py-10 text-center text-sm text-slate-500 shadow-sm">No intervention outcomes have been recorded.</div>
          <% end %>
        </div>
      </section>
    </div>

    <aside>
      <div class="sticky top-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-bold">Academic activity</h2>
        <p class="mt-1 text-sm text-slate-500">Chronological evidence across mastery, assessments, signals, and outcomes.</p>
        <div class="mt-5 space-y-5">
          <% if @activity_items.any? %>
            <% @activity_items.each do |item| %>
              <div class="relative pl-5 before:absolute before:left-0 before:top-1.5 before:size-2 before:rounded-full before:bg-[#32766b]">
                <div class="flex items-center justify-between gap-2"><span class="text-[10px] font-bold uppercase tracking-wider text-[#df6b57]"><%= item.fetch(:kind) %></span><span class="text-[10px] text-slate-400"><%= item.fetch(:at).to_date.to_fs(:short) %></span></div>
                <p class="mt-1 text-sm font-bold text-slate-800"><%= item.fetch(:title) %></p>
                <p class="mt-1 line-clamp-3 text-xs leading-5 text-slate-500"><%= item.fetch(:detail) %></p>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-slate-500">No academic activity has been recorded.</p>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</div>
