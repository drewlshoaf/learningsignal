<% content_for :title, "New student data import · LearningSignal" %>

<div class="mx-auto max-w-3xl px-5 py-8 lg:px-8 lg:py-10">
  <%= link_to "← Import history", student_data_imports_path, class: "text-sm font-bold text-[#32766b] hover:text-[#173f3a]" %>

  <div class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#df6b57]">Preview before applying</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Import student data</h1>
    <p class="mt-2 text-sm leading-6 text-slate-500">Use synthetic student records only during local development. LearningSignal validates the complete CSV and saves nothing until you confirm the preview.</p>

    <% if @data_import.errors.any? %>
      <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
        <p class="font-bold">Please correct the upload</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% @data_import.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @data_import, class: "mt-7 space-y-6" do |form| %>
      <div>
        <%= form.label :section_id, "Section", class: "block text-sm font-bold text-slate-700" %>
        <%= form.collection_select :section_id, @sections, :id, ->(section) { "#{section.course.name} · #{section.name}" }, { prompt: "Choose a section" }, required: true, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:border-[#32766b] focus:outline-none focus:ring-2 focus:ring-[#32766b]/20" %>
      </div>

      <fieldset>
        <legend class="text-sm font-bold text-slate-700">Import type</legend>
        <div class="mt-2 grid gap-3 sm:grid-cols-2">
          <% [["roster", "Roster and enrollment", "Create or update synthetic students and enroll them."], ["mastery", "Mastery history", "Add objective scores and rerun deterministic signals."]].each do |value, label, description| %>
            <label class="cursor-pointer rounded-2xl border border-slate-200 p-4 has-[:checked]:border-[#32766b] has-[:checked]:bg-[#f3f8f6]">
              <span class="flex items-start gap-3">
                <%= form.radio_button :import_type, value, required: true, class: "mt-1 accent-[#32766b]" %>
                <span>
                  <span class="block text-sm font-bold text-slate-800"><%= label %></span>
                  <span class="mt-1 block text-xs leading-5 text-slate-500"><%= description %></span>
                  <%= link_to "Download template", template_student_data_imports_path(import_type: value), class: "mt-2 inline-block text-xs font-bold text-[#32766b] hover:text-[#173f3a]" %>
                </span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div>
        <%= form.label :file, "CSV file", class: "block text-sm font-bold text-slate-700" %>
        <div class="mt-2 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5">
          <%= form.file_field :file, required: true, accept: ".csv,text/csv", class: "block w-full text-sm text-slate-600 file:mr-4 file:rounded-lg file:border-0 file:bg-[#dceae6] file:px-4 file:py-2.5 file:text-sm file:font-bold file:text-[#173f3a] hover:file:bg-[#cce0da]" %>
          <p class="mt-3 text-xs text-slate-500">UTF-8 CSV only, up to 5 MB and 2,000 nonblank rows.</p>
        </div>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-6 sm:flex-row sm:justify-end">
        <%= link_to "Cancel", student_data_imports_path, class: "inline-flex items-center justify-center rounded-xl px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100" %>
        <%= form.submit "Upload and preview", class: "cursor-pointer rounded-xl bg-[#173f3a] px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#22554e]" %>
      </div>
    <% end %>
  </div>
</div>
