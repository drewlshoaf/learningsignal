<% content_for :title, "#{@signal.student.display_name} · LearningSignal" %>

<div class="mx-auto max-w-5xl px-5 py-8 lg:px-8 lg:py-10">
  <%= link_to "← Back to #{@signal.section.course.name}", root_path, class: "text-sm font-semibold text-slate-500 hover:text-[#173f3a]" %>

  <div class="mt-6 flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
    <div class="flex items-center gap-4">
      <span class="grid size-14 place-items-center rounded-2xl bg-[#dceae6] text-lg font-bold text-[#173f3a]"><%= initials(@signal.student.display_name) %></span>
      <div>
        <h1 class="text-3xl font-semibold tracking-tight"><%= @signal.student.display_name %></h1>
        <p class="mt-1 text-sm text-slate-500"><%= @signal.section.course.name %> · <%= @signal.section.name %> · Synthetic record</p>
      </div>
    </div>
    <%= priority_badge(@signal.priority) %>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1.25fr_0.75fr]">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#df6b57]">Detected signal</p>
      <h2 class="mt-3 text-xl font-bold"><%= @signal.title %></h2>
      <p class="mt-3 leading-7 text-slate-600"><%= @signal.explanation %></p>

      <div class="mt-7 border-t border-slate-100 pt-6">
        <div class="flex items-end justify-between">
          <div>
            <p class="text-sm font-bold"><%= @signal.learning_objective.title %></p>
            <p class="text-xs text-slate-500"><%= @signal.learning_objective.code %></p>
          </div>
          <span class="text-xs font-semibold text-slate-400">Mastery history</span>
        </div>
        <div class="mt-5 flex h-40 items-end gap-4 rounded-xl bg-slate-50 p-5">
          <% @mastery_snapshots.each do |snapshot| %>
            <div class="flex flex-1 flex-col items-center gap-2">
              <span class="text-xs font-bold text-slate-700"><%= snapshot.score.to_i %>%</span>
              <div class="w-full max-w-16 rounded-t-md bg-[#32766b]" style="height: <%= snapshot.score %>%"></div>
              <span class="text-[10px] font-semibold text-slate-400"><%= snapshot.observed_on.strftime("%b %-d") %></span>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <aside class="rounded-2xl bg-[#173f3a] p-6 text-white shadow-sm">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-200">AI-assisted investigation</p>
      <h2 class="mt-3 text-xl font-semibold">Trace the evidence before choosing an intervention.</h2>
      <ul class="mt-5 space-y-3 text-sm leading-6 text-emerald-50/80">
        <li>✓ Collect performance history</li>
        <li>✓ Retrieve objective-aligned curriculum</li>
        <li>✓ Validate every material citation</li>
        <li>✓ Keep approval with the teacher</li>
      </ul>
      <% if @investigation %>
        <%= link_to "Open latest investigation", investigation_path(@investigation), class: "mt-7 block rounded-xl bg-white px-4 py-3 text-center text-sm font-bold text-[#173f3a] hover:bg-emerald-50" %>
        <%= button_to "Run a new investigation", student_signal_investigations_path(@signal), class: "mt-3 w-full cursor-pointer rounded-xl border border-white/30 px-4 py-3 text-sm font-bold text-white hover:bg-white/10" %>
      <% else %>
        <%= button_to "Start investigation", student_signal_investigations_path(@signal), class: "mt-7 w-full cursor-pointer rounded-xl bg-white px-4 py-3 text-sm font-bold text-[#173f3a] hover:bg-emerald-50" %>
      <% end %>
      <p class="mt-4 text-center text-[11px] leading-5 text-emerald-100/60">No plan affects a student until you edit and approve it.</p>
    </aside>
  </div>
</div>
