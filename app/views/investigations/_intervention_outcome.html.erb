<section id="intervention-outcome" class="mt-7 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#df6b57]">Intervention follow-up</p>
      <h2 class="mt-2 text-xl font-bold">Pre- and post-intervention comparison</h2>
    </div>
    <% if outcome %>
      <div class="flex items-center gap-3"><%= outcome_status_badge(outcome.status) %><%= link_to "Update outcome", edit_intervention_plan_intervention_outcome_path(plan), class: "text-sm font-bold text-[#32766b] hover:text-[#173f3a]" %></div>
    <% else %>
      <%= link_to "Record outcome", new_intervention_plan_intervention_outcome_path(plan), class: "rounded-xl bg-[#173f3a] px-4 py-3 text-sm font-bold text-white hover:bg-[#245c54]" %>
    <% end %>
  </div>

  <% if outcome %>
    <% baseline = plan.baseline_mastery_snapshot %>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Before</p><p class="mt-2 text-2xl font-semibold"><%= baseline ? "#{baseline.score.to_i}%" : "—" %></p><p class="mt-1 text-xs text-slate-500"><%= baseline&.observed_on&.to_fs(:short) || "No baseline" %></p></div>
      <div class="rounded-xl bg-[#f8fcfa] p-4"><p class="text-xs font-bold uppercase tracking-wider text-emerald-500">After</p><p class="mt-2 text-2xl font-semibold text-emerald-800"><%= outcome.follow_up_mastery_score ? "#{outcome.follow_up_mastery_score.to_i}%" : "Pending" %></p><p class="mt-1 text-xs text-slate-500"><%= outcome.recorded_at.to_date.to_fs(:short) %></p></div>
      <div class="rounded-xl bg-[#fffaf8] p-4"><p class="text-xs font-bold uppercase tracking-wider text-[#df6b57]">Change</p><p class="mt-2 text-2xl font-semibold"><%= mastery_change_label(baseline&.score, outcome.follow_up_mastery_score) %></p><div class="mt-1"><%= effectiveness_badge(outcome.effectiveness) %></div></div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div>
        <h3 class="text-sm font-bold">Action completion</h3>
        <div class="mt-3 space-y-2">
          <% plan.intervention_actions.each do |action| %>
            <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-3"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full text-xs font-bold <%= action.completion_status == 'completed' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-400' %>"><%= action.completion_status == "completed" ? "✓" : "·" %></span><span><span class="block text-sm font-bold text-slate-800"><%= action.title %></span><span class="mt-0.5 block text-xs text-slate-500"><%= action.completion_status.humanize %></span></span></div>
          <% end %>
        </div>
      </div>
      <div>
        <h3 class="text-sm font-bold">Teacher assessment</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= outcome.teacher_assessment.presence || "Assessment pending." %></p>
        <% if outcome.notes.present? %><p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-500"><strong class="text-slate-700">Notes:</strong> <%= outcome.notes %></p><% end %>
        <p class="mt-4 text-xs text-slate-400">Recorded by <%= outcome.recorded_by.name %> · <%= outcome.recorded_at.to_fs(:long) %></p>
      </div>
    </div>

    <details class="mt-6 rounded-xl border border-slate-200 bg-slate-50/70 p-4">
      <summary class="cursor-pointer text-sm font-bold text-slate-700">Generated recommendation vs. teacher-reviewed plan <span class="ml-2 text-xs text-slate-400"><%= plan.edited_from_original? ? "Teacher edits recorded" : "No content edits" %></span></summary>
      <div class="mt-4 grid gap-4 border-t border-slate-200 pt-4 sm:grid-cols-2">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Generated</p>
          <p class="mt-2 text-sm leading-6 text-slate-600"><%= plan.original_snapshot["summary"] %></p>
          <ol class="mt-3 space-y-2"><% Array(plan.original_snapshot["actions"]).each do |action| %><li class="rounded-lg bg-white p-3 text-xs leading-5 text-slate-500"><strong class="block text-slate-700"><%= action["position"] %>. <%= action["title"] %></strong><%= action["instructions"] %></li><% end %></ol>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[#32766b]">Teacher reviewed</p>
          <p class="mt-2 text-sm leading-6 text-slate-600"><%= plan.summary %></p>
          <ol class="mt-3 space-y-2"><% plan.intervention_actions.each do |action| %><li class="rounded-lg bg-white p-3 text-xs leading-5 text-slate-500"><strong class="block text-slate-700"><%= action.position %>. <%= action.title %></strong><%= action.instructions %></li><% end %></ol>
        </div>
      </div>
    </details>

    <% unless outcome.completed? %><p class="mt-5 rounded-xl bg-amber-50 p-4 text-sm text-amber-800">This outcome is still in progress and is excluded from aggregate effectiveness metrics.</p><% end %>
  <% else %>
    <p class="mt-5 max-w-2xl text-sm leading-6 text-slate-500">The plan is approved. Record completion, action status, follow-up mastery, and effectiveness when follow-up evidence is available.</p>
  <% end %>
</section>
