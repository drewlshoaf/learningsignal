<% content_for :title, "Upload curriculum · LearningSignal" %>

<div class="mx-auto max-w-3xl px-5 py-8 lg:px-8 lg:py-10">
  <%= link_to "← Curriculum library", curriculum_documents_path, class: "text-sm font-bold text-[#32766b] hover:text-[#173f3a]" %>

  <div class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#df6b57]">New evidence source</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Upload curriculum PDF</h1>
    <p class="mt-3 text-sm leading-6 text-slate-500">Use synthetic or approved local content only. Text is extracted page-by-page, chunked, and embedded by the configured provider.</p>

    <% if @document.errors.any? %>
      <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
        <p class="font-bold">Please fix the following:</p>
        <ul class="mt-2 list-disc pl-5">
          <% @document.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @document, class: "mt-7 space-y-6" do |form| %>
      <div>
        <%= form.label :title, class: "block text-sm font-bold text-slate-700" %>
        <%= form.text_field :title, required: true, placeholder: "Algebra I · Linear relationships", class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none ring-[#32766b]/20 focus:border-[#32766b] focus:ring-4" %>
      </div>

      <div>
        <%= form.label :source_label, "Source", class: "block text-sm font-bold text-slate-700" %>
        <%= form.text_field :source_label, required: true, placeholder: "District curriculum", class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none ring-[#32766b]/20 focus:border-[#32766b] focus:ring-4" %>
      </div>

      <div>
        <%= form.label :learning_objective_id, "Course and learning objective", class: "block text-sm font-bold text-slate-700" %>
        <%= form.select :learning_objective_id,
          @objectives.map { |objective| ["#{objective.course.name} · #{objective.code} — #{objective.title}", objective.id] },
          { prompt: "Select an objective" },
          { required: true, class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none ring-[#32766b]/20 focus:border-[#32766b] focus:ring-4" } %>
        <p class="mt-2 text-xs leading-5 text-slate-500">Investigations retrieve only chunks associated with their objective.</p>
      </div>

      <div>
        <%= form.label :file, "PDF file", class: "block text-sm font-bold text-slate-700" %>
        <div class="mt-2 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5">
          <%= form.file_field :file, required: true, accept: "application/pdf,.pdf", class: "block w-full text-sm text-slate-600 file:mr-4 file:rounded-lg file:border-0 file:bg-[#dceae6] file:px-4 file:py-2.5 file:text-sm file:font-bold file:text-[#173f3a] hover:file:bg-[#cce0da]" %>
          <p class="mt-3 text-xs text-slate-500">PDF only, up to 25 MB. Image-only scans require OCR and will be rejected for now.</p>
        </div>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-6 sm:flex-row sm:justify-end">
        <%= link_to "Cancel", curriculum_documents_path, class: "inline-flex items-center justify-center rounded-xl px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100" %>
        <%= form.submit "Upload and process", class: "cursor-pointer rounded-xl bg-[#173f3a] px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#22554e]" %>
      </div>
    <% end %>
  </div>
</div>
