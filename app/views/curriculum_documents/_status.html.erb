<section class="mt-7 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
  <div class="grid gap-5 sm:grid-cols-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">File</p>
      <p class="mt-2 truncate text-sm font-semibold text-slate-800"><%= document.file.attached? ? document.file.filename : "No file attached" %></p>
      <% if document.file.attached? %>
        <p class="mt-1 text-xs text-slate-500"><%= number_to_human_size(document.file.byte_size) %></p>
      <% end %>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Provenance</p>
      <p class="mt-2 text-sm font-semibold text-slate-800"><%= document.source_label %></p>
      <p class="mt-1 text-xs text-slate-500">Uploaded by <%= document.uploaded_by&.name || "Seed data" %></p>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Processing</p>
      <p class="mt-2 text-sm font-semibold text-slate-800"><%= pluralize(document.page_count, "page") %> · <%= pluralize(document.chunk_count, "chunk") %></p>
      <p class="mt-1 text-xs text-slate-500"><%= document.processed_at ? "Finished #{time_ago_in_words(document.processed_at)} ago" : document.status.humanize %></p>
    </div>
  </div>

  <% if document.status.in?(%w[pending processing]) %>
    <div class="mt-5 flex items-center gap-3 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-700">
      <span class="size-2 animate-pulse rounded-full bg-sky-500"></span>
      <span><%= document.status == "pending" ? "Waiting for the local worker." : "Extracting text, building chunks, and generating embeddings." %></span>
    </div>
  <% elsif document.status == "failed" %>
    <div class="mt-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-700">
      <p class="font-bold">Processing failed</p>
      <p class="mt-1 leading-6"><%= document.failure_message %></p>
      <%= button_to "Try again", reprocess_curriculum_document_path(document), method: :post, class: "mt-3 rounded-lg bg-white px-3 py-2 text-xs font-bold text-rose-700 shadow-sm ring-1 ring-inset ring-rose-200 hover:bg-rose-100" %>
    </div>
  <% end %>
</section>
