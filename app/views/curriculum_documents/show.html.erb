<% content_for :title, "#{@document.title} · LearningSignal" %>
<%= turbo_stream_from @document %>

<div class="mx-auto max-w-5xl px-5 py-8 lg:px-8 lg:py-10">
  <%= link_to "← Curriculum library", curriculum_documents_path, class: "text-sm font-bold text-[#32766b] hover:text-[#173f3a]" %>

  <div class="mt-6">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#df6b57]">Curriculum evidence</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= @document.title %></h1>
        <p class="mt-2 text-sm text-slate-500"><%= @document.course.name %> · <%= @document.learning_objective&.code || "General" %></p>
      </div>
      <%= document_status_badge(@document.status) %>
    </div>

    <%= render "status", document: @document %>

    <% if @document.status == "ready" %>
      <section class="mt-8">
        <div class="mb-4 flex items-end justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold">Extracted evidence</h2>
            <p class="mt-1 text-sm text-slate-500">Page locators are preserved for investigation citations.</p>
          </div>
          <span class="text-xs font-semibold text-slate-400"><%= pluralize(@chunks.size, "chunk") %></span>
        </div>
        <div class="space-y-3">
          <% @chunks.each do |chunk| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between gap-4">
                <p class="text-xs font-bold uppercase tracking-wider text-[#32766b]"><%= chunk.locator %></p>
                <span class="text-xs text-slate-400"><%= pluralize(chunk.token_count, "word") %></span>
              </div>
              <p class="mt-3 text-sm leading-6 text-slate-600"><%= truncate(chunk.content, length: 700) %></p>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
