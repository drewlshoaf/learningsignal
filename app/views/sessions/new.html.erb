<% content_for :title, "Sign in · LearningSignal" %>

<div class="grid min-h-screen lg:grid-cols-[1.05fr_0.95fr]">
  <section class="relative hidden overflow-hidden bg-[#173f3a] px-12 py-14 text-white lg:flex lg:flex-col lg:justify-between">
    <div class="absolute -right-28 -top-28 size-96 rounded-full border border-white/10"></div>
    <div class="absolute -right-8 top-12 size-64 rounded-full border border-white/10"></div>
    <div class="relative flex items-center gap-3">
      <span class="grid size-10 place-items-center rounded-xl bg-white text-sm font-extrabold text-[#173f3a]">LS</span>
      <span class="text-base font-bold">LearningSignal</span>
    </div>
    <div class="relative max-w-xl pb-12">
      <p class="mb-5 text-xs font-bold uppercase tracking-[0.28em] text-emerald-200">Evidence before recommendation</p>
      <h1 class="text-5xl font-semibold leading-[1.08] tracking-tight">See the signal.<br>Trace the evidence.<br>Choose the next step.</h1>
      <p class="mt-7 max-w-lg text-lg leading-8 text-emerald-50/75">LearningSignal helps educators turn fragmented academic data into reviewable, evidence-grounded interventions.</p>
    </div>
    <div class="relative flex gap-8 text-xs font-semibold text-emerald-100/70">
      <span>Human approved</span><span>Evidence linked</span><span>Audit ready</span>
    </div>
  </section>

  <section class="flex items-center justify-center bg-[#f6f7f2] px-6 py-12">
    <div class="w-full max-w-md">
      <div class="mb-10 flex items-center gap-3 lg:hidden">
        <span class="grid size-10 place-items-center rounded-xl bg-[#173f3a] text-sm font-extrabold text-white">LS</span>
        <span class="font-bold">LearningSignal</span>
      </div>
      <p class="text-sm font-bold text-[#df6b57]">Educator workspace</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight">Welcome back</h2>
      <p class="mt-3 text-sm leading-6 text-slate-500">Sign in to review student signals and intervention evidence.</p>

      <%= form_with url: session_path, class: "mt-9 space-y-5" do |form| %>
        <div>
          <%= form.label :email_address, "Email address", class: "mb-2 block text-sm font-semibold text-slate-700" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], placeholder: "teacher@example.org", class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm outline-none focus:border-[#32766b] focus:ring-3 focus:ring-[#32766b]/15" %>
        </div>
        <div>
          <%= form.label :password, class: "mb-2 block text-sm font-semibold text-slate-700" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm outline-none focus:border-[#32766b] focus:ring-3 focus:ring-[#32766b]/15" %>
        </div>
        <%= form.submit "Sign in to LearningSignal", class: "w-full cursor-pointer rounded-xl bg-[#173f3a] px-4 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-[#245c54]" %>
      <% end %>

      <div class="mt-8 rounded-xl border border-slate-200 bg-white/70 p-4 text-xs leading-5 text-slate-500">
        <strong class="block text-slate-700">Local demonstration account</strong>
        teacher@learningsignal.test · learning-signal-demo
      </div>
    </div>
  </section>
</div>
